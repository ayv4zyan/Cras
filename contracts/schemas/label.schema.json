{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cras.app/schemas/label.schema.json",
  "title": "Label",
  "type": "object",
  "required": [
    "id",
    "name",
    "color"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
