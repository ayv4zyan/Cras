{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cras.app/schemas/comment.schema.json",
  "title": "Comment",
  "type": "object",
  "required": [
    "id",
    "taskId",
    "content",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
