{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cras.app/schemas/task.schema.json",
  "title": "Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "priority",
    "labels",
    "version",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "plan": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["date"],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "date", "time"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "floating"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "at"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "instant"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "parentId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
